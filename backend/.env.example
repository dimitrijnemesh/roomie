# Server
PORT=3000
CORS_ORIGIN=http://localhost:3001

# Database (docker compose uses the same values)
POSTGRES_USER=roomie
POSTGRES_PASSWORD=roomie
POSTGRES_DB=roomie
DATABASE_URL=postgresql://roomie:roomie@localhost:5432/roomie?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Mail (Gmail SMTP with an app password). Leave SMTP_USER empty to log codes to the console instead of sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Roomie <roomie.ua@gmail.com>"
