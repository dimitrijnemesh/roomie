generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  verified     Boolean  @default(false)
  onboarded    Boolean  @default(false)
  /// Bumped on password change; JWTs carry it as `ver`, so older tokens stop working
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  profile      Profile?
  photos       Photo[]

  @@map("users")
}

model Profile {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  university String
  gender     String?
  /// Age is calculated from this, so it updates every year
  birthDate  DateTime? @db.Date
  /// bachelor | master | phd
  degree         String?
  faculty        String?
  specialty      String?
  /// Освітня програма; from the list or typed by the user
  specialization String?
  course     Int?
  bio        String?
  habits     Json?
  looking    Json?
  updatedAt  DateTime @updatedAt

  @@map("profiles")
}

model Photo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// File name inside UPLOAD_DIR (random, never user-provided)
  file      String   @unique
  position  Int
  createdAt DateTime @default(now())

  @@index([userId, position])
  @@map("photos")
}

/// One active code per email and purpose: "verify" (sign-up) or "reset" (forgotten password).
/// A sign-up code can't reset a password and vice versa.
model EmailCode {
  email     String
  purpose   String   @default("verify")
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@id([email, purpose])
  @@map("email_codes")
}
